# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Environment variables (NEVER commit secrets) ──────────────────────────────
.env
.env.local
.env.*.local

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
.vite/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Test / Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Playwright ────────────────────────────────────────────────────────────────
# Generated/scratch output — NOT the specs under tests/playwright/.
# MCP browser snapshots (page-*.yml) + console dumps:
.playwright-mcp/
# per-run artifacts (traces, screenshots on failure):
test-results/
# HTML reporter output:
playwright-report/
blob-report/
playwright/.cache/
