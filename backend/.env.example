# ─────────────────────────────────────────────────────────────────────────────
# QuizzerApp backend environment variables
# Copy to .env and fill in your values:  cp .env.example .env
# Run uvicorn from the backend/ directory.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Docker (local dev) — matches docker-compose.yaml credentials:
DATABASE_URL=postgresql+asyncpg://quizzer:quizzer_dev_pass@localhost:5432/quizzerapp

# Neon (cloud / production) — paste your Neon connection string:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxxx.us-east-1.aws.neon.tech/quizzerapp?ssl=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key-at-least-32-chars

# ── LLM APIs (only needed for RAG pipeline — Phase 5) ────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── File Storage (only needed for document uploads — Phase 5) ─────────────────
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# Add your deployed frontend URL here in production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Tests ─────────────────────────────────────────────────────────────────────
# Docker (local dev) — uses the quizzerapp_test DB created by init.sql:
TEST_DATABASE_URL=postgresql+asyncpg://quizzer:quizzer_dev_pass@localhost:5432/quizzerapp_test
